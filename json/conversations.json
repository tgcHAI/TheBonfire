        "screenName": "SYSTEM"
      },
      {
        "text": "Alright.",
        "time": "00:05",
        "delayMs": 5000,
        "screenName": "Director"
      },
      {
        "text": "Who routed the unverified signal into my primary terminal ten minutes ago?",
